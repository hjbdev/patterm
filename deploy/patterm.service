# Generated by scripts/install-service.mjs. Install as a systemd user unit.
[Unit]
Description=Patterm project agent workbench
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=exec
WorkingDirectory=@APP_ROOT@
EnvironmentFile=@ENV_FILE@
ExecStart=@NODE@ @ENTRY_POINT@
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=25
UMask=0077
OOMPolicy=continue
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
