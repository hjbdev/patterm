# Generated by scripts/install-service.mjs. Each instance owns one terminal host.
[Unit]
Description=Patterm terminal host %i

[Service]
Type=exec
WorkingDirectory=@HOST_DIR@
EnvironmentFile=@ENV_FILE@
ExecStart=@HOST_BINARY@ --socket @HOST_SOCKET@ --host-id %i
KillMode=control-group
TimeoutStopSec=25
UMask=0077
StandardOutput=journal
StandardError=journal
