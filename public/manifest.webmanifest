{
  "id": "/",
  "name": "Patterm",
  "short_name": "Patterm",
  "description": "Your remote agent workbench",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "launch_handler": { "client_mode": "focus-existing" },
  "background_color": "#080808",
  "theme_color": "#080808",
  "shortcuts": [
    { "name": "Projects", "url": "/projects", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Routines", "url": "/routines", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Usage", "url": "/usage", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] }
  ],
  "screenshots": [
    { "src": "/screenshots/narrow-1.png", "sizes": "1170x2532", "type": "image/png", "form_factor": "narrow", "label": "Follow an agent's reasoning, code and tool use from your phone" },
    { "src": "/screenshots/narrow-2.png", "sizes": "1170x2532", "type": "image/png", "form_factor": "narrow", "label": "Every project's agents at a glance: working, idle, or waiting for you" },
    { "src": "/screenshots/wide-1.png", "sizes": "1920x1200", "type": "image/png", "form_factor": "wide", "label": "Several coding agents side by side, with each session's worktrees, todos and links" }
  ],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
