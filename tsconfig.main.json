{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist/main",
    "types": ["node", "electron"],
    "esModuleInterop": true
  },
  "include": [
    "app/**/*.ts",
    "database/schema/**/*.ts",
    "database/migrations/**/*.ts",
    "desktop/**/*.ts",
    "routes/**/*.ts",
    "scripts/**/*.ts"
  ]
}
